# Track only our code (evident/) and the paper sources (evident_acl/).
# Everything else in this folder (BIRD, Spider, MultiTableQA, MultiTabQA, TQA-Bench, reference papers, templates,
# backups) is third-party or scratch material and is not versioned here.
/*
!/.gitignore
!/evident/
!/evident_acl/

# evident: generated data, results, models and caches are rebuilt by the pipeline (see evident/RUNBOOK.md)
/evident/data/
/evident/reports/
/evident/models/
/evident/texput.log
/evident/*.pdf

# paper build outputs
/evident_acl/*.aux
/evident_acl/*.log
/evident_acl/*.out
/evident_acl/*.bbl
/evident_acl/*.blg
/evident_acl/*.synctex.gz
/evident_acl/*.pdf

__pycache__/
*.pyc
.DS_Store
